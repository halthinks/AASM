{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aasm.dev/schemas/lexicographic-result.schema.json",
  "title": "AASM v0.52 Lexicographic Multi-Objective Result",
  "type": "object",
  "additionalProperties": false,
  "required": ["result_id", "problem_fingerprint", "selected", "stages", "enumeration_certificate_id", "verification_status", "fingerprint"],
  "properties": {
    "result_id": {"type": "string", "minLength": 1},
    "problem_fingerprint": {"type": "string", "minLength": 1},
    "selected": {
      "type": "object",
      "additionalProperties": false,
      "required": ["solution_id", "assignment", "values"],
      "properties": {
        "solution_id": {"type": "string", "minLength": 1},
        "assignment": {"type": "object", "additionalProperties": {"type": "number"}},
        "values": {"type": "object", "additionalProperties": {"type": "number"}}
      }
    },
    "stages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["objective_id", "priority", "sense", "tolerance", "optimum", "candidates_before", "candidates_after", "surviving_solution_ids"],
        "properties": {
          "objective_id": {"type": "string", "minLength": 1},
          "priority": {"type": "integer", "minimum": 0},
          "sense": {"enum": ["MINIMIZE", "MAXIMIZE"]},
          "tolerance": {"type": "number", "minimum": 0},
          "optimum": {"type": "number"},
          "candidates_before": {"type": "integer", "minimum": 1},
          "candidates_after": {"type": "integer", "minimum": 1},
          "surviving_solution_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
        }
      }
    },
    "enumeration_certificate_id": {"type": "string", "minLength": 1},
    "verification_status": {"enum": ["PASS", "FAIL"]},
    "fingerprint": {"type": "string", "minLength": 1}
  }
}
