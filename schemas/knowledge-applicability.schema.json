{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aasm.dev/schemas/knowledge-applicability.schema.json",
  "title": "AASM Knowledge Applicability and Application",
  "oneOf": [
    {"$ref": "#/$defs/KnowledgeItem"},
    {"$ref": "#/$defs/KnowledgeSelection"},
    {"$ref": "#/$defs/ApplicabilityCheck"},
    {"$ref": "#/$defs/KnowledgeApplication"}
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "id": {"type": "string", "minLength": 1},
    "KnowledgeItem": {
      "type": "object",
      "required": ["knowledge_id", "knowledge_kind", "source_scope_id", "source_object_id", "source_fingerprint", "applicability_scope_ids", "applicability_predicates", "invalidation_triggers", "source_authority_transfer", "fingerprint"],
      "properties": {
        "knowledge_id": {"$ref": "#/$defs/id"},
        "knowledge_kind": {"$ref": "#/$defs/id"},
        "content": {},
        "source_scope_id": {"$ref": "#/$defs/id"},
        "source_object_id": {"$ref": "#/$defs/id"},
        "source_fingerprint": {"$ref": "#/$defs/sha256"},
        "applicability_scope_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "applicability_predicates": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "invalidation_triggers": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "source_evidence_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "source_run_id": {"type": "string"},
        "freshness_seconds": {"type": ["number", "null"], "minimum": 0},
        "created_at": {"type": "number", "minimum": 0},
        "confidence": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "metadata": {"type": "object"},
        "source_authority_transfer": {"const": "NEVER"},
        "fingerprint": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    },
    "KnowledgeSelection": {
      "type": "object",
      "required": ["selection_id", "knowledge_id", "knowledge_fingerprint", "target_scope_id", "target_semantic_fingerprint", "selection_basis", "selected_by", "applicability_claim", "authority_claim", "fingerprint"],
      "properties": {
        "selection_id": {"$ref": "#/$defs/id"},
        "knowledge_id": {"$ref": "#/$defs/id"},
        "knowledge_fingerprint": {"$ref": "#/$defs/sha256"},
        "target_scope_id": {"$ref": "#/$defs/id"},
        "target_semantic_fingerprint": {"$ref": "#/$defs/sha256"},
        "selection_basis": {"$ref": "#/$defs/id"},
        "selected_by": {"$ref": "#/$defs/id"},
        "selection_evidence_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "rank": {"type": ["integer", "null"], "minimum": 0},
        "confidence": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "metadata": {"type": "object"},
        "applicability_claim": {"const": "NONE"},
        "authority_claim": {"const": "NONE"},
        "fingerprint": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    },
    "ApplicabilityCheck": {
      "type": "object",
      "required": ["applicability_id", "knowledge_id", "knowledge_fingerprint", "selection_id", "selection_fingerprint", "target_scope_id", "target_semantic_fingerprint", "predicate_results", "status", "authority_claim", "fingerprint"],
      "properties": {
        "applicability_id": {"$ref": "#/$defs/id"},
        "knowledge_id": {"$ref": "#/$defs/id"},
        "knowledge_fingerprint": {"$ref": "#/$defs/sha256"},
        "selection_id": {"$ref": "#/$defs/id"},
        "selection_fingerprint": {"$ref": "#/$defs/sha256"},
        "target_scope_id": {"$ref": "#/$defs/id"},
        "target_semantic_fingerprint": {"$ref": "#/$defs/sha256"},
        "predicate_results": {"type": "array", "minItems": 1, "items": {"type": "object"}},
        "assessed_by": {"type": "string"},
        "assessed_at": {"type": "number", "minimum": 0},
        "invalidation_triggers": {"type": "array", "items": {"type": "string"}},
        "metadata": {"type": "object"},
        "status": {"enum": ["APPLICABLE", "INAPPLICABLE", "INCONCLUSIVE"]},
        "authority_claim": {"const": "NONE"},
        "fingerprint": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    },
    "KnowledgeApplication": {
      "type": "object",
      "required": ["application_id", "knowledge_id", "knowledge_fingerprint", "selection_id", "selection_fingerprint", "applicability_id", "applicability_fingerprint", "target_scope_id", "target_semantic_fingerprint", "application_kind", "verification_effect", "application_evidence_ids", "authorization_id", "authority", "authorized_proposal_fingerprint", "authorization_event_id", "applied_by", "applied_at", "source_authority_inherited", "fingerprint"],
      "properties": {
        "application_id": {"$ref": "#/$defs/id"},
        "knowledge_id": {"$ref": "#/$defs/id"},
        "knowledge_fingerprint": {"$ref": "#/$defs/sha256"},
        "selection_id": {"$ref": "#/$defs/id"},
        "selection_fingerprint": {"$ref": "#/$defs/sha256"},
        "applicability_id": {"$ref": "#/$defs/id"},
        "applicability_fingerprint": {"$ref": "#/$defs/sha256"},
        "target_scope_id": {"$ref": "#/$defs/id"},
        "target_semantic_fingerprint": {"$ref": "#/$defs/sha256"},
        "application_kind": {"$ref": "#/$defs/id"},
        "verification_effect": {"enum": ["NONE", "REDUCE", "REPLACE"]},
        "application_evidence_ids": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/id"}},
        "authorization_id": {"$ref": "#/$defs/id"},
        "authority": {"$ref": "#/$defs/id"},
        "authorized_proposal_fingerprint": {"$ref": "#/$defs/sha256"},
        "authorization_event_id": {"$ref": "#/$defs/id"},
        "applied_by": {"$ref": "#/$defs/id"},
        "applied_at": {"type": "number", "minimum": 0},
        "metadata": {"type": "object"},
        "source_authority_inherited": {"const": false},
        "fingerprint": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    }
  }
}
