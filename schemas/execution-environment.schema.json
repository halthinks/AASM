{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aasm.dev/schemas/execution-environment.schema.json",
  "title": "AASM Execution Environment v1",
  "type": "object",
  "required": [
    "environment_id", "contract_id", "contract_version", "workspace_id", "scope_id", "subject_id",
    "environment_namespace", "stable_environment_id", "environment_revision_id", "problem_revision_id",
    "external_revision_id", "environment_level", "instance_id", "configuration_revision_id", "qualified_at_ns",
    "physical_identity_id", "physical_identity_fingerprint", "calibration_bindings", "source_trust_id",
    "source_trust_fingerprint", "qualification_basis_ids", "attributes", "logical_context_fingerprint", "fingerprint"
  ],
  "properties": {
    "environment_id": {"type": "string", "minLength": 1},
    "contract_id": {"const": "aasm.execution.environment.v1"},
    "contract_version": {"const": "0.1.0"},
    "workspace_id": {"type": "string", "minLength": 1},
    "scope_id": {"type": "string", "minLength": 1},
    "subject_id": {"type": "string", "minLength": 1},
    "environment_namespace": {"type": "string", "minLength": 1},
    "stable_environment_id": {"type": "string", "minLength": 1},
    "environment_revision_id": {"type": "string", "minLength": 1},
    "problem_revision_id": {"type": "string"},
    "external_revision_id": {"type": "string"},
    "environment_level": {"enum": ["MODEL", "SIMULATION", "SIL", "HIL", "BENCH", "CONTROLLED_PHYSICAL", "OPERATIONAL"]},
    "instance_id": {"type": "string", "minLength": 1},
    "configuration_revision_id": {"type": "string"},
    "qualified_at_ns": {"type": ["integer", "null"], "minimum": 0, "maximum": 9223372036854775807},
    "physical_identity_id": {"type": "string"},
    "physical_identity_fingerprint": {"type": "string"},
    "calibration_bindings": {
      "type": "object",
      "additionalProperties": {"type": "string", "minLength": 1}
    },
    "source_trust_id": {"type": "string"},
    "source_trust_fingerprint": {"type": "string"},
    "qualification_basis_ids": {
      "type": "array", "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "attributes": {
      "type": "object",
      "additionalProperties": {"type": "string"}
    },
    "logical_context_fingerprint": {"type": "string", "minLength": 16},
    "fingerprint": {"type": "string", "minLength": 16}
  },
  "allOf": [
    {
      "if": {"properties": {"physical_identity_id": {"minLength": 1}}, "required": ["physical_identity_id"]},
      "then": {"properties": {"physical_identity_fingerprint": {"minLength": 1}}}
    },
    {
      "if": {"properties": {"source_trust_id": {"minLength": 1}}, "required": ["source_trust_id"]},
      "then": {"properties": {"source_trust_fingerprint": {"minLength": 1}, "qualified_at_ns": {"type": "integer"}}}
    }
  ],
  "additionalProperties": false
}
