{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aasm.local/schemas/observability-report.schema.json",
  "title": "AASM Observability Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "machine_id",
    "machine_state",
    "machine_version",
    "decision_graph",
    "obligation_graph",
    "evidence_graph",
    "causal_graph",
    "conflict_timeline",
    "fairness_debt",
    "event_timeline",
    "package_history",
    "candidate_summary",
    "assurance_summary"
  ],
  "properties": {
    "machine_id": {"type": "string"},
    "machine_state": {"type": "string"},
    "machine_version": {"type": "integer", "minimum": 0},
    "decision_graph": {"type": "object"},
    "obligation_graph": {"type": "object"},
    "evidence_graph": {"type": "object"},
    "causal_graph": {"type": "object"},
    "conflict_timeline": {"type": "array"},
    "fairness_debt": {"type": "array"},
    "event_timeline": {"type": "array"},
    "package_history": {"type": "object"},
    "candidate_summary": {"type": "object"},
    "assurance_summary": {"type": "object"}
  }
}
