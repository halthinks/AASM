{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aasm.dev/schemas/solver-proof-artifact.schema.json",
  "title": "AASM Solver Proof Artifact",
  "type": "object",
  "required": ["artifact_id", "claim_id", "claim_fingerprint", "proof_format", "payload", "producer_id", "producer_version", "fingerprint"],
  "properties": {
    "artifact_id": {"type": "string", "minLength": 1},
    "claim_id": {"type": "string", "minLength": 1},
    "claim_fingerprint": {"type": "string", "minLength": 1},
    "proof_format": {"type": "string", "minLength": 1},
    "payload": {"type": "object"},
    "producer_id": {"type": "string", "minLength": 1},
    "producer_version": {"type": "string", "minLength": 1},
    "fingerprint": {"type": "string", "minLength": 1}
  },
  "additionalProperties": false
}
