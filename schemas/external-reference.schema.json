{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aasm.dev/schemas/external-reference.schema.json",
  "title": "AASM External Reference v1",
  "type": "object",
  "required": ["contract_id", "contract_version", "namespace", "external_id", "role", "revision", "source_fingerprint", "source_location", "semantic_entity_id", "metadata", "key", "fingerprint"],
  "properties": {
    "contract_id": {"const": "aasm.external.reference.v1"},
    "contract_version": {"const": "0.1.0"},
    "namespace": {"type": "string", "minLength": 1},
    "external_id": {"type": "string", "minLength": 1},
    "role": {"type": "string", "minLength": 1},
    "revision": {"type": "string"},
    "source_fingerprint": {"type": "string"},
    "source_location": {"type": "object"},
    "semantic_entity_id": {"type": "string"},
    "metadata": {"type": "object"},
    "key": {"type": "string", "minLength": 3},
    "fingerprint": {"type": "string", "minLength": 16}
  },
  "additionalProperties": false
}
