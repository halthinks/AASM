{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aasm.dev/schemas/risk-envelope.schema.json",
  "title": "AASM Risk Envelope v1",
  "type": "object",
  "required": ["envelope_id", "contract_id", "contract_version", "envelope_name", "subject", "problem_revision_id", "problem_revision_fingerprint", "hazards", "metadata", "fingerprint"],
  "properties": {
    "envelope_id": {"type": "string", "pattern": "^risk-envelope-[0-9a-f]{24}$"},
    "contract_id": {"const": "aasm.risk.envelope.v1"},
    "contract_version": {"const": "0.1.0"},
    "envelope_name": {"type": "string", "minLength": 1},
    "subject": {"$ref": "#/$defs/subject"},
    "problem_revision_id": {"type": "string", "minLength": 1},
    "problem_revision_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "hazards": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/hazard"}},
    "metadata": {"type": "object"},
    "fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "$defs": {
    "subject": {
      "type": "object",
      "required": ["semantic_type_id", "object_id", "fingerprint", "revision_id", "revision_fingerprint"],
      "properties": {
        "semantic_type_id": {"type": "string", "minLength": 1},
        "object_id": {"type": "string", "minLength": 1},
        "fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "revision_id": {"type": "string"},
        "revision_fingerprint": {"type": "string"}
      },
      "additionalProperties": false
    },
    "hazard": {
      "type": "object",
      "required": ["hazard_id", "rule_revision_id", "rule_fingerprint", "severity", "treatment", "evidence_ids", "metadata"],
      "properties": {
        "hazard_id": {"type": "string", "minLength": 1},
        "rule_revision_id": {"type": "string", "minLength": 1},
        "rule_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "severity": {"enum": ["MINOR", "MAJOR", "SEVERE", "CATASTROPHIC"]},
        "treatment": {"enum": ["PROHIBITED", "MITIGATION_REQUIRED", "EXPLICIT_ACCEPTANCE_REQUIRED", "ADVISORY"]},
        "evidence_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "metadata": {"type": "object"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
