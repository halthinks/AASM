{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aasm.dev/schemas/causal-decision.schema.json",
  "title": "AASM Causal Decision v1",
  "type": "object",
  "required": ["decision_id", "subject", "value", "rejected_alternatives", "confidence", "reasoning", "caused_by_event_ids", "caused_by_artifact_ids"],
  "properties": {
    "decision_id": {"type": "string", "minLength": 1},
    "subject": {"type": "string", "minLength": 1},
    "value": {},
    "kind": {"type": "string", "enum": ["ROOT", "PINNED", "EXPLICIT", "DERIVED"]},
    "status": {"type": "string"},
    "parent_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "antecedent_constraint_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "evidence_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "plan_node_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "scope": {"type": "object"},
    "rejected_alternatives": {"type": "array", "items": {"type": "object"}},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "reasoning": {"type": "string"},
    "caused_by_event_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "caused_by_artifact_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
  },
  "additionalProperties": true
}
