{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aasm.dev/schemas/solver-runtime-provenance-v2.schema.json",
  "title": "AASM Solver Runtime Provenance v2",
  "type": "object",
  "required": ["provenance_id", "contract_id", "contract_version", "execution_id", "source_result_id", "source_result_fingerprint", "source_outcome_id", "source_outcome_fingerprint", "profile_id", "profile_fingerprint", "provider_id", "provider_implementation", "provider_version", "adapter_id", "adapter_version", "solver_command", "requested_options", "effective_options", "environment_fingerprint", "build_fingerprint", "provider_status_map_id", "provider_status_map_fingerprint", "numeric_policy_id", "numeric_policy_fingerprint", "dependency_fingerprints", "metadata", "fingerprint"],
  "properties": {
    "provenance_id": {"type": "string", "minLength": 1},
    "contract_id": {"const": "aasm.solver.runtime-provenance.v2"},
    "contract_version": {"const": "0.1.0"},
    "execution_id": {"type": "string", "minLength": 1},
    "source_result_id": {"type": "string", "minLength": 1},
    "source_result_fingerprint": {"type": "string", "minLength": 16},
    "source_outcome_id": {"type": "string", "minLength": 1},
    "source_outcome_fingerprint": {"type": "string", "minLength": 16},
    "profile_id": {"type": "string", "minLength": 1},
    "profile_fingerprint": {"type": "string", "minLength": 16},
    "provider_id": {"type": "string", "minLength": 1},
    "provider_implementation": {"type": "string", "minLength": 1},
    "provider_version": {"type": "string", "minLength": 1},
    "adapter_id": {"type": "string", "minLength": 1},
    "adapter_version": {"type": "string", "minLength": 1},
    "solver_command": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "requested_options": {"type": "object"},
    "effective_options": {"type": "object"},
    "environment_fingerprint": {"type": "string", "minLength": 1},
    "build_fingerprint": {"type": "string"},
    "provider_status_map_id": {"type": "string"},
    "provider_status_map_fingerprint": {"type": "string"},
    "numeric_policy_id": {"type": "string"},
    "numeric_policy_fingerprint": {"type": "string"},
    "dependency_fingerprints": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "metadata": {"type": "object"},
    "fingerprint": {"type": "string", "minLength": 16}
  },
  "additionalProperties": false
}
