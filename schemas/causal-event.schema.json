{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aasm.dev/schemas/causal-event.schema.json",
  "title": "AASM Causal Event Identity v1",
  "type": "object",
  "required": [
    "event_id", "contract_id", "contract_version", "workspace_id", "scope_id", "subject_id",
    "node_id", "boot_epoch", "sequence", "event_kind", "object_kind", "object_id",
    "source_time_ns", "source_clock_id", "source_clock_quality", "source_clock_uncertainty_ns",
    "receipt_time_ns", "receipt_clock_id", "problem_revision_id", "external_revision_id", "fingerprint"
  ],
  "properties": {
    "event_id": {"type": "string", "minLength": 1},
    "contract_id": {"const": "aasm.event.causality.v1"},
    "contract_version": {"const": "0.1.0"},
    "workspace_id": {"type": "string", "minLength": 1},
    "scope_id": {"type": "string", "minLength": 1},
    "subject_id": {"type": "string", "minLength": 1},
    "node_id": {"type": "string", "minLength": 1},
    "boot_epoch": {"type": "integer", "minimum": 1, "maximum": 9223372036854775807},
    "sequence": {"type": "integer", "minimum": 0, "maximum": 9223372036854775807},
    "event_kind": {"type": "string", "minLength": 1},
    "object_kind": {"type": "string", "minLength": 1},
    "object_id": {"type": "string", "minLength": 1},
    "source_time_ns": {"type": ["integer", "null"], "minimum": 0, "maximum": 9223372036854775807},
    "source_clock_id": {"type": "string"},
    "source_clock_quality": {"enum": ["UNKNOWN", "UNSYNCHRONIZED", "MONOTONIC_LOCAL", "SYNCHRONIZED", "TRACEABLE"]},
    "source_clock_uncertainty_ns": {"type": ["integer", "null"], "minimum": 0, "maximum": 9223372036854775807},
    "receipt_time_ns": {"type": ["integer", "null"], "minimum": 0, "maximum": 9223372036854775807},
    "receipt_clock_id": {"type": "string"},
    "problem_revision_id": {"type": "string"},
    "external_revision_id": {"type": "string"},
    "fingerprint": {"type": "string", "minLength": 16}
  },
  "additionalProperties": false
}
