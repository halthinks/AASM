{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aasm.dev/schemas/authority-domain.schema.json",
  "title": "AASM Authority Domain",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "domain_id", "contract_id", "contract_version", "workspace_id", "scope_id",
    "domain_name", "subject_id", "permitted_effect_classes", "preemptor_principal_ids",
    "problem_revision_id", "external_revision_id", "metadata", "fingerprint"
  ],
  "properties": {
    "domain_id": {"type": "string", "minLength": 1},
    "contract_id": {"const": "aasm.authority.domain.v1"},
    "contract_version": {"const": "0.1.0"},
    "workspace_id": {"type": "string", "minLength": 1},
    "scope_id": {"type": "string", "minLength": 1},
    "domain_name": {"type": "string", "minLength": 1},
    "subject_id": {"type": "string", "minLength": 1},
    "permitted_effect_classes": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "preemptor_principal_ids": {
      "type": "array", "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "problem_revision_id": {"type": "string"},
    "external_revision_id": {"type": "string"},
    "metadata": {"type": "object"},
    "fingerprint": {"type": "string", "minLength": 32}
  }
}
