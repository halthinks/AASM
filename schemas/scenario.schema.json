{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aasm.dev/schemas/scenario.schema.json",
  "title": "AASM Scenario v1",
  "type": "object",
  "required": ["scenario_id", "contract_id", "contract_version", "scenario_name", "base_problem_revision_id", "base_problem_revision_fingerprint", "bindings", "external_references", "evidence_ids", "tags", "metadata", "fingerprint"],
  "properties": {
    "scenario_id": {"type": "string", "pattern": "^scenario-[0-9a-f]{24}$"},
    "contract_id": {"const": "aasm.scenario.v1"},
    "contract_version": {"const": "0.1.0"},
    "scenario_name": {"type": "string", "minLength": 1},
    "base_problem_revision_id": {"type": "string", "minLength": 1},
    "base_problem_revision_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "bindings": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/binding"}},
    "external_references": {"type": "array", "items": {"$ref": "#/$defs/externalRef"}, "uniqueItems": true},
    "evidence_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "tags": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "metadata": {"type": "object"},
    "fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "$defs": {
    "subjectRef": {
      "type": "object",
      "required": ["semantic_type_id", "object_id", "fingerprint", "revision_id", "revision_fingerprint"],
      "properties": {
        "semantic_type_id": {"type": "string", "minLength": 1},
        "object_id": {"type": "string", "minLength": 1},
        "fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "revision_id": {"type": "string"},
        "revision_fingerprint": {"type": "string", "pattern": "^$|^[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    },
    "externalRef": {
      "type": "object",
      "required": ["contract_id", "contract_version", "namespace", "external_id", "role", "revision", "source_fingerprint", "source_location", "semantic_entity_id", "metadata", "key", "fingerprint"],
      "properties": {
        "contract_id": {"const": "aasm.external.reference.v1"},
        "contract_version": {"const": "0.1.0"},
        "namespace": {"type": "string", "minLength": 1},
        "external_id": {"type": "string", "minLength": 1},
        "role": {"type": "string", "minLength": 1},
        "revision": {"type": "string"},
        "source_fingerprint": {"type": "string"},
        "source_location": {"type": "object"},
        "semantic_entity_id": {"type": "string"},
        "metadata": {"type": "object"},
        "key": {"type": "string", "minLength": 3},
        "fingerprint": {"type": "string", "minLength": 16}
      },
      "additionalProperties": false
    },
    "binding": {
      "type": "object",
      "required": ["parameter_id", "binding_kind", "literal_value", "value_ref", "metadata"],
      "properties": {
        "parameter_id": {"type": "string", "minLength": 1},
        "binding_kind": {"enum": ["LITERAL", "SEMANTIC_REF"]},
        "literal_value": {"type": ["string", "integer", "boolean", "null"]},
        "value_ref": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/subjectRef"}]},
        "metadata": {"type": "object"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
