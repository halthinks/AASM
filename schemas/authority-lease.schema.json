{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aasm.dev/schemas/authority-lease.schema.json",
  "title": "AASM Authority Lease",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "lease_id", "contract_id", "contract_version", "domain_id", "workspace_id", "scope_id",
    "holder_principal_id", "issuer_principal_id", "epoch", "valid_from", "expires_at",
    "permitted_effect_classes", "problem_revision_id", "external_revision_id",
    "revocation_generation", "metadata", "fingerprint"
  ],
  "properties": {
    "lease_id": {"type": "string", "minLength": 1},
    "contract_id": {"const": "aasm.authority.lease.v1"},
    "contract_version": {"const": "0.1.0"},
    "domain_id": {"type": "string", "minLength": 1},
    "workspace_id": {"type": "string", "minLength": 1},
    "scope_id": {"type": "string", "minLength": 1},
    "holder_principal_id": {"type": "string", "minLength": 1},
    "issuer_principal_id": {"type": "string", "minLength": 1},
    "epoch": {"type": "integer", "minimum": 1},
    "valid_from": {"type": "number"},
    "expires_at": {"type": "number"},
    "permitted_effect_classes": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "problem_revision_id": {"type": "string"},
    "external_revision_id": {"type": "string"},
    "revocation_generation": {"type": "integer", "minimum": 0},
    "metadata": {"type": "object"},
    "fingerprint": {"type": "string", "minLength": 32}
  }
}
