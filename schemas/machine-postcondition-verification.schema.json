{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aasm.dev/schemas/machine-postcondition-verification.schema.json",
  "title": "AASM Machine Postcondition Verification v1",
  "type": "object",
  "required": [
    "verification_id", "contract_id", "contract_version", "transition_id", "effect_id",
    "binding_id", "verifier_principal_id", "verdict", "target_state_claim_ids",
    "achieved_state_claim_ids", "machine_observation_ids", "comparison", "metadata", "fingerprint"
  ],
  "properties": {
    "verification_id": {"type": "string", "minLength": 1},
    "contract_id": {"const": "aasm.machine.postcondition-verification.v1"},
    "contract_version": {"const": "0.1.0"},
    "transition_id": {"type": "string", "minLength": 1},
    "effect_id": {"type": "string", "minLength": 1},
    "binding_id": {"type": "string", "minLength": 1},
    "verifier_principal_id": {"type": "string", "minLength": 1},
    "verdict": {"enum": ["VERIFIED", "MISMATCH"]},
    "target_state_claim_ids": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "achieved_state_claim_ids": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "machine_observation_ids": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "comparison": {"type": "object"},
    "metadata": {"type": "object"},
    "fingerprint": {"type": "string", "minLength": 16}
  },
  "additionalProperties": false
}
