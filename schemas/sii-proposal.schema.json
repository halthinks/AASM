{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aasm.dev/schemas/sii-proposal.schema.json",
  "title": "AASM SII Structured Proposal",
  "type": "object",
  "additionalProperties": false,
  "required": ["proposal_id", "proposer_id", "decision_name", "scope_id", "chosen", "confidence", "task_class", "rejected_alternatives", "artifacts", "evidence_ids", "fingerprint"],
  "properties": {
    "proposal_id": {"type": "string", "minLength": 1},
    "proposer_id": {"type": "string", "minLength": 1},
    "decision_name": {"type": "string", "minLength": 1},
    "scope_id": {"type": "string", "minLength": 1},
    "chosen": {},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "task_class": {"type": "string", "minLength": 1},
    "rejected_alternatives": {"type": "array", "items": {"type": "object"}},
    "artifacts": {"type": "array", "items": {"type": "object"}},
    "evidence_ids": {"type": "array", "items": {"type": "string"}},
    "expected_input_tokens": {"type": ["integer", "null"], "minimum": 0},
    "expected_output_tokens": {"type": ["integer", "null"], "minimum": 0},
    "expected_tool_calls": {"type": ["integer", "null"], "minimum": 0},
    "rationale_summary": {"type": "string"},
    "metadata": {"type": "object"},
    "fingerprint": {"type": "string", "minLength": 1}
  }
}
