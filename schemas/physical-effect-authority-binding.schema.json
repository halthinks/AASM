{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aasm.dev/schemas/physical-effect-authority-binding.schema.json",
  "title": "AASM Physical Effect Authority Binding",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "binding_id",
    "contract_id",
    "contract_version",
    "effect_id",
    "effect_intent_id",
    "effect_intent_fingerprint",
    "workspace_id",
    "scope_id",
    "subject_id",
    "authority_domain_id",
    "authority_domain_fingerprint",
    "authority_lease_id",
    "authority_lease_fingerprint",
    "effect_capability_id",
    "effect_capability_fingerprint",
    "holder_principal_id",
    "authority_epoch",
    "effective_revocation_generation",
    "operation",
    "numeric_parameters",
    "problem_revision_id",
    "external_revision_id",
    "metadata",
    "fingerprint"
  ],
  "properties": {
    "binding_id": {"type": "string", "minLength": 1},
    "contract_id": {"const": "aasm.effect.physical-authority-binding.v1"},
    "contract_version": {"const": "0.1.0"},
    "effect_id": {"type": "string", "minLength": 1},
    "effect_intent_id": {"type": "string", "minLength": 1},
    "effect_intent_fingerprint": {"type": "string", "minLength": 1},
    "workspace_id": {"type": "string", "minLength": 1},
    "scope_id": {"type": "string", "minLength": 1},
    "subject_id": {"type": "string", "minLength": 1},
    "authority_domain_id": {"type": "string", "minLength": 1},
    "authority_domain_fingerprint": {"type": "string", "minLength": 1},
    "authority_lease_id": {"type": "string", "minLength": 1},
    "authority_lease_fingerprint": {"type": "string", "minLength": 1},
    "effect_capability_id": {"type": "string", "minLength": 1},
    "effect_capability_fingerprint": {"type": "string", "minLength": 1},
    "holder_principal_id": {"type": "string", "minLength": 1},
    "authority_epoch": {"type": "integer", "minimum": 1},
    "effective_revocation_generation": {"type": "integer", "minimum": 0},
    "operation": {"type": "string", "minLength": 1},
    "numeric_parameters": {
      "type": "object",
      "additionalProperties": {"type": "number"}
    },
    "problem_revision_id": {"type": "string"},
    "external_revision_id": {"type": "string"},
    "metadata": {"type": "object"},
    "fingerprint": {"type": "string", "minLength": 1}
  }
}
