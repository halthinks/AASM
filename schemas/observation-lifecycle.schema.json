{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aasm.dev/schemas/observation-lifecycle.schema.json",
  "title": "AASM Observation Lifecycle Record v1",
  "type": "object",
  "required": [
    "record_id", "contract_id", "contract_version", "workspace_id", "scope_id", "subject_id",
    "state_namespace", "stage", "value", "processor_principal_id", "transformation_id", "source_refs",
    "problem_revision_id", "external_revision_id", "environment_binding_id", "environment_binding_fingerprint",
    "calibration_bindings", "freshness_assessment_id", "freshness_assessment_fingerprint", "evidence_ids",
    "attributes", "fingerprint"
  ],
  "properties": {
    "record_id": {"type": "string", "minLength": 1},
    "contract_id": {"const": "aasm.observation.lifecycle.v1"},
    "contract_version": {"const": "0.1.0"},
    "workspace_id": {"type": "string", "minLength": 1},
    "scope_id": {"type": "string", "minLength": 1},
    "subject_id": {"type": "string", "minLength": 1},
    "state_namespace": {"type": "string", "minLength": 1},
    "stage": {"enum": ["RAW", "NORMALIZED", "CALIBRATED", "DERIVED", "VALIDATED"]},
    "value": {},
    "processor_principal_id": {"type": "string", "minLength": 1},
    "transformation_id": {"type": "string", "minLength": 1},
    "source_refs": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {
        "type": "object",
        "required": ["source_kind", "source_id", "source_fingerprint"],
        "properties": {
          "source_kind": {"enum": ["MACHINE_STATE_OBSERVATION", "LIFECYCLE_RECORD", "FUSION_RECORD"]},
          "source_id": {"type": "string", "minLength": 1},
          "source_fingerprint": {"type": "string", "minLength": 16}
        },
        "additionalProperties": false
      }
    },
    "problem_revision_id": {"type": "string"},
    "external_revision_id": {"type": "string"},
    "environment_binding_id": {"type": "string"},
    "environment_binding_fingerprint": {"type": "string"},
    "calibration_bindings": {"type": "object", "additionalProperties": {"type": "string", "minLength": 1}},
    "freshness_assessment_id": {"type": "string"},
    "freshness_assessment_fingerprint": {"type": "string"},
    "evidence_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "attributes": {"type": "object", "additionalProperties": {"type": "string"}},
    "fingerprint": {"type": "string", "minLength": 16}
  },
  "allOf": [
    {
      "if": {"properties": {"stage": {"const": "RAW"}}, "required": ["stage"]},
      "then": {"properties": {"source_refs": {"minItems": 1, "maxItems": 1, "items": {"properties": {"source_kind": {"const": "MACHINE_STATE_OBSERVATION"}}}}}}
    },
    {
      "if": {"properties": {"stage": {"const": "CALIBRATED"}}, "required": ["stage"]},
      "then": {"properties": {"calibration_bindings": {"minProperties": 1}}}
    }
  ],
  "additionalProperties": false
}
