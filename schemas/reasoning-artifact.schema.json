{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aasm.dev/schemas/reasoning-artifact.schema.json",
  "title": "AASM Reasoning Artifact v1",
  "type": "object",
  "required": [
    "artifact_id",
    "kind",
    "statement",
    "producer",
    "subject_ids",
    "premise_artifact_ids",
    "evidence_ids",
    "verifier_requirements",
    "scope",
    "metadata",
    "fingerprint"
  ],
  "properties": {
    "artifact_id": {"type": "string", "minLength": 1},
    "kind": {"type": "string", "enum": ["Claim", "Hypothesis", "Lemma", "Invariant", "Counterexample", "Definition", "Assumption", "Observation", "Derivation", "Refutation", "ObjectiveResult"]},
    "statement": {"type": "string", "minLength": 1},
    "producer": {
      "type": "object",
      "required": ["producer_id", "authority_class", "version", "metadata"],
      "properties": {
        "producer_id": {"type": "string", "minLength": 1},
        "authority_class": {"type": "string", "enum": ["PROPOSER", "OBSERVER", "VERIFIER", "POLICY", "CONTROLLER"]},
        "version": {"type": "string"},
        "metadata": {"type": "object"}
      },
      "additionalProperties": false
    },
    "subject_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "premise_artifact_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "evidence_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "verifier_requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["verifier_id", "required_verdict", "metadata"],
        "properties": {
          "verifier_id": {"type": "string", "minLength": 1},
          "required_verdict": {"const": "PASS"},
          "metadata": {"type": "object"}
        },
        "additionalProperties": false
      }
    },
    "confidence": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "scope": {"type": "object"},
    "metadata": {"type": "object"},
    "fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": false
}
