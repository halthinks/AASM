{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aasm.dev/schemas/enumeration-cursor.schema.json",
  "title": "AASM Enumeration Cursor",
  "type": "object",
  "required": ["cursor_id", "pool_id", "model_fingerprint", "mode", "next_state_index", "total_states", "accepted_solution_ids", "exclusion_ids", "exhausted", "fingerprint"],
  "properties": {
    "cursor_id": {"type": "string", "minLength": 1},
    "pool_id": {"type": "string", "minLength": 1},
    "model_fingerprint": {"type": "string", "minLength": 1},
    "mode": {"enum": ["COMPLETE_FINITE_ENUMERATION", "BOUNDED_PARTIAL_POOL", "TOP_K", "DIVERSE_POOL", "INCUMBENT_HISTORY"]},
    "next_state_index": {"type": "integer", "minimum": 0},
    "total_states": {"type": "integer", "minimum": 0},
    "accepted_solution_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "exclusion_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "exhausted": {"type": "boolean"},
    "fingerprint": {"type": "string", "minLength": 1}
  },
  "additionalProperties": false
}
