{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/halthinks/AASM/schemas/resource.schema.json",
  "title": "AASM Resource Record",
  "type": "object",
  "required": ["resource_id", "kind", "capabilities", "capacity", "cost_per_unit", "reliability", "enabled", "metadata"],
  "properties": {
    "resource_id": {"type": "string", "minLength": 1},
    "kind": {"type": "string", "minLength": 1},
    "capabilities": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "capacity": {"type": "number", "minimum": 0},
    "cost_per_unit": {"type": "number", "minimum": 0},
    "reliability": {"type": "number", "minimum": 0, "maximum": 1},
    "enabled": {"type": "boolean"},
    "metadata": {"type": "object"}
  },
  "additionalProperties": false
}
