{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aasm.dev/schemas/calibration-revocation.schema.json",
  "title": "AASM Calibration Revocation v1",
  "type": "object",
  "required": ["revocation_id", "contract_id", "contract_version", "calibration_id", "calibration_fingerprint", "revoked_at_ns", "reason_code", "fingerprint"],
  "properties": {
    "revocation_id": {"type": "string", "minLength": 1},
    "contract_id": {"const": "aasm.calibration.v1"},
    "contract_version": {"const": "0.1.0"},
    "calibration_id": {"type": "string", "minLength": 1},
    "calibration_fingerprint": {"type": "string", "minLength": 16},
    "revoked_at_ns": {"type": "integer", "minimum": 0, "maximum": 9223372036854775807},
    "reason_code": {"type": "string", "minLength": 1},
    "fingerprint": {"type": "string", "minLength": 16}
  },
  "additionalProperties": false
}
