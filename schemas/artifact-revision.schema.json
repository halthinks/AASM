{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aasm.dev/schemas/artifact-revision.schema.json",
  "title": "AASM Artifact Revision v1",
  "type": "object",
  "required": [
    "revision_id",
    "contract_id",
    "contract_version",
    "logical_artifact_id",
    "content_sha256",
    "semantic_projection_sha256",
    "artifact_ref",
    "artifact_kind",
    "parent_revision_ids",
    "parent_revision_fingerprints",
    "revision_relation",
    "producer_id",
    "producer_kind",
    "machine_id",
    "effect_id",
    "source_problem_revision_id",
    "source_problem_revision_fingerprint",
    "environment_id",
    "environment_fingerprint",
    "refinement_run_id",
    "source_external_references",
    "format_id",
    "schema_id",
    "tool_id",
    "tool_version",
    "external_references",
    "evidence_ids",
    "metadata",
    "fingerprint",
    "storage_binding_fingerprint"
  ],
  "properties": {
    "revision_id": {
      "type": "string",
      "pattern": "^artifact-revision-[0-9a-f]{24}$"
    },
    "contract_id": {
      "const": "aasm.artifact.revision.v1"
    },
    "contract_version": {
      "const": "0.3.0"
    },
    "logical_artifact_id": {
      "type": "string",
      "minLength": 1
    },
    "content_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "semantic_projection_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "artifact_ref": {
      "type": "string"
    },
    "artifact_kind": {
      "type": "string"
    },
    "parent_revision_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^artifact-revision-[0-9a-f]{24}$"
      }
    },
    "parent_revision_fingerprints": {
      "type": "object",
      "propertyNames": {
        "pattern": "^artifact-revision-[0-9a-f]{24}$"
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    },
    "revision_relation": {
      "enum": [
        "CREATED",
        "CREATED_FROM",
        "MODIFIES",
        "DERIVED_FROM",
        "MERGES",
        "REPLACES"
      ]
    },
    "producer_id": {
      "type": "string",
      "minLength": 1
    },
    "producer_kind": {
      "type": "string"
    },
    "machine_id": {
      "type": "string"
    },
    "effect_id": {
      "type": "string"
    },
    "source_problem_revision_id": {
      "type": "string"
    },
    "source_problem_revision_fingerprint": {
      "type": "string",
      "pattern": "^$|^[0-9a-f]{64}$"
    },
    "environment_id": {
      "type": "string"
    },
    "environment_fingerprint": {
      "type": "string",
      "pattern": "^$|^[0-9a-f]{64}$"
    },
    "refinement_run_id": {
      "type": "string"
    },
    "source_external_references": {
      "type": "array",
      "items": {
        "$ref": "external-reference.schema.json"
      }
    },
    "format_id": {
      "type": "string",
      "minLength": 1
    },
    "schema_id": {
      "type": "string"
    },
    "tool_id": {
      "type": "string"
    },
    "tool_version": {
      "type": "string"
    },
    "external_references": {
      "type": "array",
      "items": {
        "$ref": "external-reference.schema.json"
      }
    },
    "evidence_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "metadata": {
      "type": "object"
    },
    "fingerprint": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "storage_binding_fingerprint": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "revision_relation": {"const": "CREATED"}
        }
      },
      "then": {
        "properties": {
          "parent_revision_ids": {"maxItems": 0},
          "parent_revision_fingerprints": {"maxProperties": 0}
        }
      }
    },
    {
      "if": {
        "properties": {
          "revision_relation": {"const": "MERGES"}
        }
      },
      "then": {
        "properties": {
          "parent_revision_ids": {"minItems": 2},
          "parent_revision_fingerprints": {"minProperties": 2}
        }
      }
    }
  ],
  "additionalProperties": false
}
