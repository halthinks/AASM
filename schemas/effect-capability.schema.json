{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aasm.dev/schemas/effect-capability.schema.json",
  "title": "AASM Bounded Effect Capability",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "capability_id", "contract_id", "contract_version", "domain_id", "authority_lease_id",
    "workspace_id", "scope_id", "subject_id", "holder_principal_id", "issuer_principal_id",
    "allowed_operations", "numeric_bounds", "valid_from", "expires_at", "authority_epoch",
    "problem_revision_id", "external_revision_id", "remaining_delegation_depth",
    "revocation_generation", "parent_capability_id", "parent_capability_fingerprint",
    "parent_revocation_generation", "metadata", "fingerprint"
  ],
  "properties": {
    "capability_id": {"type": "string", "minLength": 1},
    "contract_id": {"const": "aasm.effect.capability.v1"},
    "contract_version": {"const": "0.1.0"},
    "domain_id": {"type": "string", "minLength": 1},
    "authority_lease_id": {"type": "string", "minLength": 1},
    "workspace_id": {"type": "string", "minLength": 1},
    "scope_id": {"type": "string", "minLength": 1},
    "subject_id": {"type": "string", "minLength": 1},
    "holder_principal_id": {"type": "string", "minLength": 1},
    "issuer_principal_id": {"type": "string", "minLength": 1},
    "allowed_operations": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "numeric_bounds": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["minimum", "maximum"],
        "properties": {
          "minimum": {"type": "number"},
          "maximum": {"type": "number"}
        }
      }
    },
    "valid_from": {"type": "number"},
    "expires_at": {"type": "number"},
    "authority_epoch": {"type": "integer", "minimum": 1},
    "problem_revision_id": {"type": "string"},
    "external_revision_id": {"type": "string"},
    "remaining_delegation_depth": {"type": "integer", "minimum": 0},
    "revocation_generation": {"type": "integer", "minimum": 0},
    "parent_capability_id": {"type": "string"},
    "parent_capability_fingerprint": {"type": "string"},
    "parent_revocation_generation": {"type": "integer", "minimum": 0},
    "metadata": {"type": "object"},
    "fingerprint": {"type": "string", "minLength": 32}
  }
}
