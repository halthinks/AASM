{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aasm.dev/schemas/reactive-obligation-rule.schema.json",
  "title": "AASM Reactive Obligation Rule v1",
  "type": "object",
  "required": ["rule_id", "watch_event_types", "statement", "handler_name", "scope_id", "once", "event_data_equals", "required_evidence_types", "decision_dependencies", "metadata", "fingerprint"],
  "properties": {
    "rule_id": {"type": "string", "minLength": 1},
    "watch_event_types": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
    "statement": {"type": "string", "minLength": 1},
    "handler_name": {"type": "string", "minLength": 1},
    "scope_id": {"type": "string", "minLength": 1},
    "once": {"type": "boolean"},
    "event_data_equals": {"type": "object"},
    "required_evidence_types": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "decision_dependencies": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "metadata": {"type": "object"},
    "fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "additionalProperties": false
}
