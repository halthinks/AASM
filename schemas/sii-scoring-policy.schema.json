{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/halthinks/AASM/schemas/sii-scoring-policy.schema.json",
  "title": "AASM Governed SII Scoring Policy",
  "type": "object",
  "required": ["policy_id", "name", "version", "profiles", "tiers", "projection_window", "fingerprint"],
  "properties": {
    "policy_id": {"type": "string", "minLength": 1},
    "name": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "profiles": {"type": "object"},
    "tiers": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "projection_window": {"type": "integer", "minimum": 1},
    "exploration_reuse_below": {"type": "number", "minimum": 0, "maximum": 1},
    "exploitation_reuse_above": {"type": "number", "minimum": 0, "maximum": 1},
    "metadata": {"type": "object"},
    "fingerprint": {"type": "string", "minLength": 64, "maxLength": 64}
  },
  "additionalProperties": false
}
