{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aasm.local/schemas/history-check-report.schema.json",
  "title": "AASM Durable History Check Report",
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "machine_id", "checked_sequence", "valid", "issues"],
  "properties": {
    "status": {"enum": ["PASS", "FAIL", "INCONCLUSIVE"]},
    "machine_id": {"type": "string"},
    "checked_sequence": {"type": "integer", "minimum": 0},
    "valid": {"type": "boolean"},
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code", "message", "severity"],
        "properties": {
          "code": {"type": "string"},
          "message": {"type": "string"},
          "severity": {"type": "string"},
          "sequence": {"type": ["integer", "null"]},
          "data": {"type": "object"}
        }
      }
    }
  }
}
