{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aasm.dev/schemas/observation-freshness.schema.json",
  "title": "AASM Observation Freshness Assessment v1",
  "type": "object",
  "required": [
    "assessment_id", "contract_id", "contract_version", "workspace_id", "scope_id", "subject_id", "state_namespace",
    "observation_id", "observation_fingerprint", "state_claim_id", "state_claim_fingerprint",
    "causal_event_id", "causal_event_fingerprint", "actual_boot_epoch", "expected_boot_epoch",
    "actual_problem_revision_id", "expected_problem_revision_id", "actual_external_revision_id", "expected_external_revision_id",
    "reference_time_ns", "reference_clock_id", "max_age_ns", "minimum_source_clock_quality",
    "max_source_clock_uncertainty_ns", "allow_receipt_time_fallback", "age_basis", "age_ns", "status", "reasons", "fingerprint"
  ],
  "properties": {
    "assessment_id": {"type": "string", "minLength": 1},
    "contract_id": {"const": "aasm.observation.freshness.v1"},
    "contract_version": {"const": "0.1.0"},
    "workspace_id": {"type": "string", "minLength": 1},
    "scope_id": {"type": "string", "minLength": 1},
    "subject_id": {"type": "string", "minLength": 1},
    "state_namespace": {"type": "string", "minLength": 1},
    "observation_id": {"type": "string", "minLength": 1},
    "observation_fingerprint": {"type": "string", "minLength": 16},
    "state_claim_id": {"type": "string", "minLength": 1},
    "state_claim_fingerprint": {"type": "string", "minLength": 16},
    "causal_event_id": {"type": "string", "minLength": 1},
    "causal_event_fingerprint": {"type": "string", "minLength": 16},
    "actual_boot_epoch": {"type": "integer", "minimum": 1, "maximum": 9223372036854775807},
    "expected_boot_epoch": {"type": "integer", "minimum": 1, "maximum": 9223372036854775807},
    "actual_problem_revision_id": {"type": "string"},
    "expected_problem_revision_id": {"type": "string"},
    "actual_external_revision_id": {"type": "string"},
    "expected_external_revision_id": {"type": "string"},
    "reference_time_ns": {"type": "integer", "minimum": 0, "maximum": 9223372036854775807},
    "reference_clock_id": {"type": "string", "minLength": 1},
    "max_age_ns": {"type": "integer", "minimum": 0, "maximum": 9223372036854775807},
    "minimum_source_clock_quality": {"enum": ["UNKNOWN", "UNSYNCHRONIZED", "MONOTONIC_LOCAL", "SYNCHRONIZED", "TRACEABLE"]},
    "max_source_clock_uncertainty_ns": {"type": ["integer", "null"], "minimum": 0, "maximum": 9223372036854775807},
    "allow_receipt_time_fallback": {"type": "boolean"},
    "age_basis": {"enum": ["SOURCE_TIME", "RECEIPT_TIME", "UNRESOLVED"]},
    "age_ns": {"type": ["integer", "null"], "minimum": 0, "maximum": 9223372036854775807},
    "status": {"enum": ["FRESH", "STALE", "UNKNOWN"]},
    "reasons": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "AGE_UNRESOLVED", "BOOT_EPOCH_MISMATCH", "CLOCK_QUALITY_INSUFFICIENT", "CLOCK_UNCERTAINTY_EXCEEDED",
          "CLOCK_UNCERTAINTY_UNKNOWN", "EXTERNAL_REVISION_MISMATCH", "MAX_AGE_EXCEEDED", "NEGATIVE_AGE",
          "PROBLEM_REVISION_MISMATCH", "RECEIPT_CLOCK_MISMATCH", "RECEIPT_FALLBACK_USED", "RECEIPT_TIME_MISSING",
          "SOURCE_CLOCK_MISMATCH", "SOURCE_TIME_MISSING"
        ]
      }
    },
    "fingerprint": {"type": "string", "minLength": 16}
  },
  "additionalProperties": false
}
