{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aasm.dev/schemas/resource-capacity.schema.json",
  "title": "AASM Resource Capacity",
  "type": "object",
  "required": ["resource_id", "resource_class", "unit", "window_kind"],
  "properties": {
    "resource_id": {"type": "string", "minLength": 1},
    "resource_class": {"type": "string", "minLength": 1},
    "unit": {"type": "string", "minLength": 1},
    "owner_principal_id": {"type": ["string", "null"]},
    "workspace_id": {"type": ["string", "null"]},
    "scope_id": {"type": ["string", "null"]},
    "provider": {"type": ["string", "null"]},
    "window_kind": {
      "enum": ["FIXED", "ROLLING", "REFILLING", "CREDIT_BALANCE", "UNBOUNDED", "UNKNOWN"]
    },
    "total": {"type": ["number", "null"], "minimum": 0},
    "consumed": {"type": "number", "minimum": 0, "default": 0},
    "committed": {"type": "number", "minimum": 0, "default": 0},
    "protected_reserve": {"type": "number", "minimum": 0, "default": 0},
    "window_seconds": {"type": ["number", "null"], "minimum": 0},
    "resets_at": {"type": ["string", "null"], "format": "date-time"},
    "refill_rate_per_second": {"type": ["number", "null"], "minimum": 0},
    "latest_observation": {
      "anyOf": [
        {"$ref": "resource-observation.schema.json"},
        {"type": "null"}
      ]
    },
    "metadata": {"type": "object"}
  },
  "additionalProperties": false
}
