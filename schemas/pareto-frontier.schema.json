{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aasm.dev/schemas/pareto-frontier.schema.json",
  "title": "AASM Pareto Frontier",
  "type": "object",
  "required": ["frontier_id", "problem_fingerprint", "mode", "points", "solution_ids", "completeness_status"],
  "properties": {
    "frontier_id": {"type": "string", "minLength": 1},
    "problem_fingerprint": {"type": "string", "minLength": 1},
    "mode": {"enum": ["EXACT_FINITE_PARETO_FRONTIER", "BOUNDED_PARTIAL_FRONTIER", "EPSILON_APPROXIMATE_FRONTIER"]},
    "points": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["solution_id", "assignment", "values"],
        "properties": {
          "solution_id": {"type": "string", "minLength": 1},
          "assignment": {"type": "object", "additionalProperties": {"type": "number"}},
          "values": {"type": "object", "additionalProperties": {"type": "number"}}
        },
        "additionalProperties": false
      }
    },
    "solution_ids": {"type": "array", "items": {"type": "string"}},
    "completeness_status": {"type": "string", "minLength": 1},
    "certificate": {"type": ["object", "null"]},
    "fingerprint": {"type": "string", "minLength": 1}
  },
  "additionalProperties": false
}
