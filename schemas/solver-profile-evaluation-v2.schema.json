{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aasm.dev/schemas/solver-profile-evaluation-v2.schema.json",
  "title": "AASM Solver Profile Evaluation v2",
  "type": "object",
  "required": ["evaluation_id", "contract_id", "contract_version", "profile_id", "profile_fingerprint", "provenance_id", "provenance_fingerprint", "compliant", "deviations", "fingerprint"],
  "properties": {
    "evaluation_id": {"type": "string", "minLength": 1},
    "contract_id": {"const": "aasm.solver.profile-evaluation.v2"},
    "contract_version": {"const": "0.1.0"},
    "profile_id": {"type": "string", "minLength": 1},
    "profile_fingerprint": {"type": "string", "minLength": 16},
    "provenance_id": {"type": "string", "minLength": 1},
    "provenance_fingerprint": {"type": "string", "minLength": 16},
    "compliant": {"type": "boolean"},
    "deviations": {"type": "array", "items": {"type": "object"}},
    "fingerprint": {"type": "string", "minLength": 16}
  },
  "additionalProperties": false
}
