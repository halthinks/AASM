{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aasm.dev/schemas/problem-delta.schema.json",
  "title": "AASM Problem Delta v1",
  "type": "object",
  "required": ["delta_id", "contract_id", "contract_version", "base_revision_id", "base_revision_fingerprint", "target_revision_id", "added_external_references", "removed_external_references", "modified_external_references", "changed_semantic_ids", "changed_quantity_ids", "changed_rule_ids", "changed_objective_ids", "changed_scenario_ids", "changed_artifact_ids", "invalidated_evidence_ids", "preserved_evidence_ids", "impacted_obligation_ids", "impacted_solver_object_ids", "incremental_eligibility", "warm_start_eligibility", "caused_by_refinement_id", "evidence_ids", "metadata", "fingerprint"],
  "properties": {
    "delta_id": {"type": "string", "minLength": 1},
    "contract_id": {"const": "aasm.problem.delta.v1"},
    "contract_version": {"const": "0.1.0"},
    "base_revision_id": {"type": "string", "minLength": 1},
    "base_revision_fingerprint": {"type": "string", "minLength": 1},
    "target_revision_id": {"type": "string", "minLength": 1},
    "added_external_references": {"type": "array", "items": {"$ref": "external-reference.schema.json"}},
    "removed_external_references": {"type": "array", "items": {"$ref": "external-reference.schema.json"}},
    "modified_external_references": {"type": "array", "items": {"$ref": "external-reference.schema.json"}},
    "changed_semantic_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "changed_quantity_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "changed_rule_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "changed_objective_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "changed_scenario_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "changed_artifact_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "invalidated_evidence_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "preserved_evidence_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "impacted_obligation_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "impacted_solver_object_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "incremental_eligibility": {"enum": ["REQUIRES_REBUILD", "INCREMENTAL_CANDIDATE", "INCREMENTAL_CERTIFIED"]},
    "warm_start_eligibility": {"enum": ["FORBIDDEN", "PERFORMANCE_ONLY_CANDIDATE", "PERFORMANCE_ONLY_VALIDATED"]},
    "caused_by_refinement_id": {"type": "string"},
    "evidence_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "metadata": {"type": "object"},
    "fingerprint": {"type": "string", "minLength": 16}
  },
  "additionalProperties": false
}
