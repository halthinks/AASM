{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aasm.dev/schemas/verification-plan.schema.json",
  "title": "AASM Verification Plan v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "plan_id", "contract_id", "contract_version", "problem_revision_id",
    "problem_revision_fingerprint", "calculus_state_fingerprint", "requirements",
    "verifier_profiles", "assignments", "producer_principal_id", "evidence_ids",
    "metadata", "fingerprint"
  ],
  "properties": {
    "plan_id": {"type": "string", "pattern": "^verification-plan-[0-9a-f]{24}$"},
    "contract_id": {"const": "aasm.verification.plan.v1"},
    "contract_version": {"const": "0.1.0"},
    "problem_revision_id": {"type": "string", "minLength": 1},
    "problem_revision_fingerprint": {"$ref": "#/$defs/sha256"},
    "calculus_state_fingerprint": {"$ref": "#/$defs/sha256"},
    "requirements": {"type": "array", "items": {"type": "object"}},
    "verifier_profiles": {"type": "array", "items": {"type": "object"}},
    "assignments": {"type": "array", "items": {"type": "object"}},
    "producer_principal_id": {"type": "string", "minLength": 1},
    "evidence_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "metadata": {"type": "object"},
    "fingerprint": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
