{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aasm.dev/schemas/verification-debt.schema.json",
  "title": "AASM Verification Debt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "projection_id", "contract_id", "contract_version", "problem_revision_id",
    "problem_revision_fingerprint", "calculus_state_fingerprint", "verification_plan_id",
    "verification_plan_fingerprint", "evidence_state_fingerprint", "applicability_fingerprint",
    "items", "metadata", "total_debt_count", "terminal_unverified_count", "fingerprint"
  ],
  "properties": {
    "projection_id": {"type": "string", "pattern": "^verification-debt-[0-9a-f]{24}$"},
    "contract_id": {"const": "aasm.verification.debt.v1"},
    "contract_version": {"const": "0.1.0"},
    "problem_revision_id": {"type": "string", "minLength": 1},
    "problem_revision_fingerprint": {"$ref": "#/$defs/sha256"},
    "calculus_state_fingerprint": {"$ref": "#/$defs/sha256"},
    "verification_plan_id": {"type": "string", "minLength": 1},
    "verification_plan_fingerprint": {"$ref": "#/$defs/sha256"},
    "evidence_state_fingerprint": {"$ref": "#/$defs/sha256"},
    "applicability_fingerprint": {"$ref": "#/$defs/sha256"},
    "items": {"type": "array", "items": {"type": "object"}},
    "metadata": {"type": "object"},
    "total_debt_count": {"type": "integer", "minimum": 0},
    "terminal_unverified_count": {"type": "integer", "minimum": 0},
    "fingerprint": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
