{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aasm.dev/schemas/machine-binding.schema.json",
  "title": "AASM Machine Binding v1",
  "type": "object",
  "required": [
    "binding_id", "contract_id", "contract_version", "workspace_id", "scope_id",
    "external_machine_id", "subject_id", "state_namespaces", "observer_capability_id",
    "executor_capability_id", "external_revision_id", "problem_revision_id",
    "fact_authority_ids", "metadata", "fingerprint"
  ],
  "properties": {
    "binding_id": {"type": "string", "minLength": 1},
    "contract_id": {"const": "aasm.machine.binding.v1"},
    "contract_version": {"const": "0.1.0"},
    "workspace_id": {"type": "string", "minLength": 1},
    "scope_id": {"type": "string", "minLength": 1},
    "external_machine_id": {"type": "string", "minLength": 1},
    "subject_id": {"type": "string", "minLength": 1},
    "state_namespaces": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "observer_capability_id": {"type": "string", "minLength": 1},
    "executor_capability_id": {"type": "string", "minLength": 1},
    "external_revision_id": {"type": "string", "minLength": 1},
    "problem_revision_id": {"type": "string"},
    "fact_authority_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "metadata": {"type": "object"},
    "fingerprint": {"type": "string", "minLength": 16}
  },
  "additionalProperties": false
}
