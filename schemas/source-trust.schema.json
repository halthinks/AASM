{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aasm.dev/schemas/source-trust.schema.json",
  "title": "AASM Source Trust Assertion v1",
  "type": "object",
  "required": [
    "trust_id", "contract_id", "contract_version", "workspace_id", "scope_id", "subject_id",
    "source_principal_id", "source_kind", "trust_disposition", "state_namespaces", "valid_from_ns",
    "expires_at_ns", "physical_identity_id", "physical_identity_fingerprint", "required_calibrations",
    "policy_basis_ids", "problem_revision_id", "external_revision_id", "fingerprint"
  ],
  "properties": {
    "trust_id": {"type": "string", "minLength": 1},
    "contract_id": {"const": "aasm.source.trust.v1"},
    "contract_version": {"const": "0.1.0"},
    "workspace_id": {"type": "string", "minLength": 1},
    "scope_id": {"type": "string", "minLength": 1},
    "subject_id": {"type": "string", "minLength": 1},
    "source_principal_id": {"type": "string", "minLength": 1},
    "source_kind": {"enum": ["SENSOR", "DEVICE", "TOOL", "PROJECT_ENGINE", "MODEL", "IMPORT", "HUMAN"]},
    "trust_disposition": {"enum": ["TRUSTED", "CONDITIONAL", "UNTRUSTED"]},
    "state_namespaces": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "valid_from_ns": {"type": "integer", "minimum": 0, "maximum": 9223372036854775807},
    "expires_at_ns": {"type": ["integer", "null"], "minimum": 0, "maximum": 9223372036854775807},
    "physical_identity_id": {"type": "string"},
    "physical_identity_fingerprint": {"type": "string"},
    "required_calibrations": {"type": "object", "additionalProperties": {"type": "string", "minLength": 16}},
    "policy_basis_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "problem_revision_id": {"type": "string"},
    "external_revision_id": {"type": "string"},
    "fingerprint": {"type": "string", "minLength": 16}
  },
  "additionalProperties": false
}
