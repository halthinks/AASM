{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/halthinks/AASM/schemas/semantic-solver-rc-benchmark-report.schema.json",
  "title": "AASM Semantic Solver RC Benchmark Report",
  "type": "object",
  "required": ["status", "real_backends", "workload", "measurements", "checks", "interpretation", "inner_solver_claim", "workload_fingerprint"],
  "properties": {
    "status": {"enum": ["PASS", "FAIL"]},
    "real_backends": {"type": "boolean"},
    "workload": {"type": "object"},
    "measurements": {"type": "object"},
    "checks": {"type": "object", "additionalProperties": {"type": "boolean"}},
    "interpretation": {"type": "string", "minLength": 1},
    "inner_solver_claim": {"const": "NONE"},
    "workload_fingerprint": {"type": "string", "minLength": 32}
  },
  "additionalProperties": true
}
