{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aasm.dev/schemas/calibration.schema.json",
  "title": "AASM Calibration Certificate v1",
  "type": "object",
  "required": [
    "calibration_id", "contract_id", "contract_version", "workspace_id", "scope_id", "subject_id",
    "physical_identity_id", "physical_identity_fingerprint", "calibration_kind", "state_namespace",
    "calibration_revision_id", "procedure_id", "certificate_reference", "valid_from_ns", "expires_at_ns",
    "problem_revision_id", "external_revision_id", "fingerprint"
  ],
  "properties": {
    "calibration_id": {"type": "string", "minLength": 1},
    "contract_id": {"const": "aasm.calibration.v1"},
    "contract_version": {"const": "0.1.0"},
    "workspace_id": {"type": "string", "minLength": 1},
    "scope_id": {"type": "string", "minLength": 1},
    "subject_id": {"type": "string", "minLength": 1},
    "physical_identity_id": {"type": "string", "minLength": 1},
    "physical_identity_fingerprint": {"type": "string", "minLength": 16},
    "calibration_kind": {"enum": ["MEASUREMENT", "TIMING", "ACTUATION", "TOOL", "MODEL"]},
    "state_namespace": {"type": "string", "minLength": 1},
    "calibration_revision_id": {"type": "string", "minLength": 1},
    "procedure_id": {"type": "string", "minLength": 1},
    "certificate_reference": {"type": "string", "minLength": 1},
    "valid_from_ns": {"type": "integer", "minimum": 0, "maximum": 9223372036854775807},
    "expires_at_ns": {"type": ["integer", "null"], "minimum": 0, "maximum": 9223372036854775807},
    "problem_revision_id": {"type": "string"},
    "external_revision_id": {"type": "string"},
    "fingerprint": {"type": "string", "minLength": 16}
  },
  "additionalProperties": false
}
