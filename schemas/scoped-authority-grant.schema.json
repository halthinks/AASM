{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aasm.dev/schemas/scoped-authority-grant.schema.json",
  "title": "AASM Scoped Authority Grant",
  "type": "object",
  "required": [
    "grant_id",
    "subject_principal_id",
    "issuer_principal_id",
    "workspace_id",
    "scope_id",
    "capabilities",
    "effect",
    "delegable",
    "remaining_delegation_depth",
    "parent_grant_id",
    "not_before",
    "nondelegable"
  ],
  "properties": {
    "grant_id": {"type": "string", "minLength": 1},
    "subject_principal_id": {"type": "string", "minLength": 1},
    "issuer_principal_id": {"type": "string", "minLength": 1},
    "workspace_id": {"type": "string", "minLength": 1},
    "scope_id": {"type": "string", "minLength": 1},
    "capabilities": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "effect": {"enum": ["ALLOW", "DENY"]},
    "delegable": {"type": "boolean"},
    "remaining_delegation_depth": {"type": "integer", "minimum": 0},
    "parent_grant_id": {"type": "string"},
    "not_before": {"type": "number", "minimum": 0},
    "expires_at": {"type": ["number", "null"]},
    "nondelegable": {"type": "boolean"},
    "metadata": {"type": "object"},
    "fingerprint": {"type": "string", "minLength": 1}
  },
  "additionalProperties": false
}
