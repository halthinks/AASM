{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aasm.dev/schemas/reproducibility-certificate.schema.json",
  "title": "AASM Solver Reproducibility Certificate v1",
  "type": "object",
  "required": ["certificate_id", "contract_id", "contract_version", "left_run_id", "left_run_fingerprint", "right_run_id", "right_run_fingerprint", "claim_level", "configuration_same", "both_profile_compliant", "model_same", "normalized_status_same", "semantic_projection_same", "assignment_same", "objective_same", "proof_same", "artifact_same", "diagnostics", "fingerprint"],
  "properties": {
    "certificate_id": {"type": "string", "minLength": 1},
    "contract_id": {"const": "aasm.solver.reproducibility-certificate.v1"},
    "contract_version": {"const": "0.1.0"},
    "left_run_id": {"type": "string", "minLength": 1},
    "left_run_fingerprint": {"type": "string", "minLength": 16},
    "right_run_id": {"type": "string", "minLength": 1},
    "right_run_fingerprint": {"type": "string", "minLength": 16},
    "claim_level": {"enum": ["NO_REPRODUCIBILITY_CLAIM", "CONFIGURATION_REPLAYABLE", "SEMANTIC_OUTCOME_REPRODUCED", "ASSIGNMENT_REPRODUCED", "OBJECTIVE_REPRODUCED", "PROOF_REPRODUCED", "ARTIFACT_REPRODUCED"]},
    "configuration_same": {"type": "boolean"},
    "both_profile_compliant": {"type": "boolean"},
    "model_same": {"type": "boolean"},
    "normalized_status_same": {"type": "boolean"},
    "semantic_projection_same": {"type": ["boolean", "null"]},
    "assignment_same": {"type": "boolean"},
    "objective_same": {"type": ["boolean", "null"]},
    "proof_same": {"type": ["boolean", "null"]},
    "artifact_same": {"type": ["boolean", "null"]},
    "diagnostics": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "fingerprint": {"type": "string", "minLength": 16}
  },
  "additionalProperties": false
}
