{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aasm.dev/schemas/continuous-model.schema.json",
  "title": "AASM Continuous Quadratic/Conic Model v1",
  "type": "object",
  "required": ["model_id", "contract_id", "contract_version", "name", "variables", "quadratic_constraints", "conic_constraints", "objective", "problem_revision_id", "problem_revision_fingerprint", "metadata", "required_feature_ids", "fingerprint"],
  "properties": {
    "model_id": {"type": "string", "minLength": 1},
    "contract_id": {"const": "aasm.optimization.continuous-model.v1"},
    "contract_version": {"const": "0.1.0"},
    "name": {"type": "string", "minLength": 1},
    "variables": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "quadratic_constraints": {"type": "array", "items": {"type": "object"}},
    "conic_constraints": {"type": "array", "items": {"type": "object"}},
    "objective": {"type": ["object", "null"]},
    "problem_revision_id": {"type": "string"},
    "problem_revision_fingerprint": {"type": "string"},
    "metadata": {"type": "object"},
    "required_feature_ids": {"type": "array", "uniqueItems": true, "items": {"enum": ["LINEAR_REAL", "QUADRATIC", "CONIC"]}},
    "fingerprint": {"type": "string", "minLength": 16}
  },
  "additionalProperties": false
}
