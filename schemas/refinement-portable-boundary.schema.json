{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aasm.dev/schemas/refinement-portable-boundary.schema.json",
  "title": "AASM S5.7 Portable Refinement Boundary",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "boundary_id",
    "contract_id",
    "contract_version",
    "workspace_id",
    "scope_id",
    "problem_id",
    "revision_refs",
    "proposal_ids",
    "validation_ids",
    "application_ids",
    "termination_ids",
    "evidence_ids",
    "obligation_ids",
    "conflict_ids",
    "core_ids",
    "transition_refs",
    "embedded_engines",
    "authority_claim",
    "fingerprint"
  ],
  "properties": {
    "boundary_id": {"type": "string", "pattern": "^portable-refinement-[0-9a-f]{24}$"},
    "contract_id": {"const": "aasm.refinement.portable-boundary.v1"},
    "contract_version": {"const": "0.1.0"},
    "workspace_id": {"type": "string", "minLength": 1},
    "scope_id": {"type": "string", "minLength": 1},
    "problem_id": {"type": "string", "minLength": 1},
    "revision_refs": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/revisionRef"}
    },
    "proposal_ids": {"$ref": "#/$defs/stringRefs"},
    "validation_ids": {"$ref": "#/$defs/stringRefs"},
    "application_ids": {"$ref": "#/$defs/stringRefs"},
    "termination_ids": {"$ref": "#/$defs/stringRefs"},
    "evidence_ids": {"$ref": "#/$defs/stringRefs"},
    "obligation_ids": {"$ref": "#/$defs/stringRefs"},
    "conflict_ids": {"$ref": "#/$defs/stringRefs"},
    "core_ids": {"$ref": "#/$defs/stringRefs"},
    "transition_refs": {
      "type": "array",
      "items": {"$ref": "#/$defs/transitionRef"}
    },
    "embedded_engines": {"const": []},
    "authority_claim": {"const": "NONE"},
    "fingerprint": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "stringRefs": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "revisionRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["revision_id", "revision_fingerprint", "fingerprint"],
      "properties": {
        "revision_id": {"type": "string", "minLength": 1},
        "revision_fingerprint": {"$ref": "#/$defs/sha256"},
        "fingerprint": {"$ref": "#/$defs/sha256"}
      }
    },
    "transitionRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "delta_id",
        "delta_fingerprint",
        "base_revision_id",
        "target_revision_id",
        "transition_evidence_id",
        "fingerprint"
      ],
      "properties": {
        "delta_id": {"type": "string", "minLength": 1},
        "delta_fingerprint": {"$ref": "#/$defs/sha256"},
        "base_revision_id": {"type": "string", "minLength": 1},
        "target_revision_id": {"type": "string", "minLength": 1},
        "transition_evidence_id": {"type": "string", "minLength": 1},
        "fingerprint": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
