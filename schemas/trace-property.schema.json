{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aasm.dev/schemas/trace-property.schema.json",
  "title": "AASM Trace Property v1",
  "type": "object",
  "required": ["property_id", "contract_id", "contract_version", "property_name", "kind", "patterns", "max_step_distance", "problem_revision_id", "problem_revision_fingerprint", "invariant_classification", "metadata", "fingerprint"],
  "properties": {
    "property_id": {"type": "string", "pattern": "^trace-property-[0-9a-f]{24}$"},
    "contract_id": {"const": "aasm.trace-property.v1"},
    "contract_version": {"const": "0.1.0"},
    "property_name": {"type": "string", "minLength": 1},
    "kind": {"enum": ["OCCURS", "NEVER_OCCURS", "PRECEDES", "SEQUENCE", "BOUNDED_EVENTUALLY_STEPS"]},
    "patterns": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/pattern"}},
    "max_step_distance": {"type": ["integer", "null"], "minimum": 0},
    "problem_revision_id": {"type": "string"},
    "problem_revision_fingerprint": {"type": "string", "pattern": "^$|^[0-9a-f]{64}$"},
    "invariant_classification": {"const": "DYNAMIC_KERNEL"},
    "metadata": {"type": "object"},
    "fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "$defs": {
    "pattern": {
      "type": "object",
      "required": ["pattern_id", "event_types", "transition_classes", "metadata"],
      "properties": {
        "pattern_id": {"type": "string", "minLength": 1},
        "event_types": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "transition_classes": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "metadata": {"type": "object"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
