{
  "$id": "https://aasm.local/schemas/profile.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "aasm_contract": {
      "const": "0.22"
    },
    "adapters": {
      "additionalProperties": {
        "additionalProperties": false,
        "properties": {
          "capabilities": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "uniqueItems": true
          },
          "config": {
            "type": "object"
          },
          "deterministic": {
            "type": "boolean"
          },
          "metadata": {
            "type": "object"
          },
          "required": {
            "type": "boolean"
          },
          "role": {
            "enum": [
              "decision_backend",
              "obligation_adapter",
              "semantic_validator",
              "conflict_explainer",
              "constraint_certifier"
            ]
          },
          "target": {
            "pattern": "^[^\\s:]+:[^\\s:]+$",
            "type": "string"
          }
        },
        "required": [
          "role",
          "target"
        ],
        "type": "object"
      },
      "propertyNames": {
        "enum": [
          "decision_backend",
          "obligation_adapter",
          "semantic_validator",
          "conflict_explainer",
          "constraint_certifier"
        ]
      },
      "type": "object"
    },
    "artifact_kinds": {
      "items": {
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "capabilities": {
      "items": {
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "decision_namespaces": {
      "items": {
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "description": {
      "minLength": 1,
      "type": "string"
    },
    "evidence_kinds": {
      "items": {
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "evolution_policy": {
      "additionalProperties": false,
      "properties": {
        "allow_runtime_proposals": {
          "type": "boolean"
        },
        "allowed_activation_actors": {
          "items": {
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        },
        "metadata": {
          "type": "object"
        },
        "minimum_evidence_count": {
          "minimum": 0,
          "type": "integer"
        },
        "mode": {
          "enum": [
            "FROZEN",
            "MANUAL",
            "PROPOSAL_ONLY",
            "GOVERNED_AUTO_CANDIDATE"
          ]
        },
        "require_conformance": {
          "type": "boolean"
        },
        "require_explicit_activation": {
          "type": "boolean"
        },
        "require_migration_for_breaking": {
          "type": "boolean"
        }
      },
      "type": "object"
    },
    "machine_definition": {
      "minLength": 1,
      "type": "string"
    },
    "metadata": {
      "type": "object"
    },
    "migrations": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "checksum": {
            "type": [
              "string",
              "null"
            ]
          },
          "compatibility": {
            "enum": [
              "BACKWARD_COMPATIBLE",
              "REQUIRES_MIGRATION",
              "BREAKING"
            ]
          },
          "evidence_ids": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "uniqueItems": true
          },
          "from_version": {
            "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$",
            "type": "string"
          },
          "metadata": {
            "type": "object"
          },
          "migration_id": {
            "minLength": 1,
            "type": "string"
          },
          "operations": {
            "items": {
              "type": "object"
            },
            "type": "array"
          },
          "to_version": {
            "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$",
            "type": "string"
          }
        },
        "required": [
          "migration_id",
          "from_version",
          "to_version",
          "compatibility",
          "operations"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "obligation_kinds": {
      "items": {
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "policies": {
      "type": "object"
    },
    "profile_id": {
      "pattern": "^[a-z0-9](?:[a-z0-9._-]*[a-z0-9])?$",
      "type": "string"
    },
    "profile_version": {
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$",
      "type": "string"
    },
    "schema_version": {
      "const": 1
    }
  },
  "required": [
    "profile_id",
    "profile_version",
    "description",
    "aasm_contract",
    "machine_definition"
  ],
  "title": "AASM Domain-Neutral Profile",
  "type": "object"
}
