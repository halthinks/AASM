{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aasm.dev/schemas/reference-domain-stress-report.schema.json",
  "title": "AASM Reference Domain Stress Report",
  "type": "object",
  "required": ["contract", "passed", "domain_count", "checks_total", "checks_passed", "domains"],
  "properties": {
    "contract": {
      "type": "object",
      "required": ["contract_id", "contract_version", "authority", "kernel_changes", "network_required", "model_key_required", "domains", "required_boundaries"],
      "properties": {
        "contract_id": {"const": "aasm.reference-domains.v1"},
        "contract_version": {"type": "string"},
        "authority": {"const": "REFERENCE_HARNESS_ONLY"},
        "kernel_changes": {"const": "NONE"},
        "network_required": {"const": false},
        "model_key_required": {"const": false},
        "domains": {"type": "array", "items": {"type": "string"}, "minItems": 5, "uniqueItems": true},
        "required_boundaries": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true}
      },
      "additionalProperties": false
    },
    "passed": {"type": "boolean"},
    "domain_count": {"type": "integer", "minimum": 1},
    "checks_total": {"type": "integer", "minimum": 1},
    "checks_passed": {"type": "integer", "minimum": 0},
    "domains": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["domain_id", "passed", "checks", "details"],
        "properties": {
          "domain_id": {
            "enum": ["constraint-solving", "software-repair", "research-synthesis", "formal-reasoning", "long-horizon-memory"]
          },
          "passed": {"type": "boolean"},
          "checks": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {"type": "boolean"}
          },
          "details": {"type": "object"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
