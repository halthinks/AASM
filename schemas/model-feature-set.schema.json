{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aasm.dev/schemas/model-feature-set.schema.json",
  "title": "AASM Model Feature Set v1",
  "type": "object",
  "required": ["feature_set_id", "contract_id", "contract_version", "model_fingerprint", "features", "problem_revision_id", "problem_revision_fingerprint", "metadata", "fingerprint"],
  "properties": {
    "feature_set_id": {"type": "string", "minLength": 1},
    "contract_id": {"const": "aasm.model.feature-set.v1"},
    "contract_version": {"const": "0.1.0"},
    "model_fingerprint": {"type": "string", "minLength": 1},
    "features": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["feature_id", "requirement_level", "parameters", "source_reference_fingerprints", "metadata", "fingerprint"],
        "properties": {
          "feature_id": {"type": "string", "minLength": 1},
          "requirement_level": {"enum": ["EXACT_ONLY", "EXACT_OR_APPROXIMATE", "VERIFIER_ONLY_ALLOWED"]},
          "parameters": {"type": "object"},
          "source_reference_fingerprints": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
          "metadata": {"type": "object"},
          "fingerprint": {"type": "string", "minLength": 16}
        },
        "additionalProperties": false
      }
    },
    "problem_revision_id": {"type": "string"},
    "problem_revision_fingerprint": {"type": "string"},
    "metadata": {"type": "object"},
    "fingerprint": {"type": "string", "minLength": 16}
  },
  "additionalProperties": false
}
