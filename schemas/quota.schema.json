{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/halthinks/AASM/schemas/quota.schema.json",
  "title": "AASM Quota Policy",
  "type": "object",
  "required": ["quota_id", "scope", "enabled"],
  "properties": {
    "quota_id": {"type": "string"},
    "scope": {"enum": ["machine", "worker", "resource"]},
    "target_id": {"type": ["string", "null"]},
    "max_active_leases": {"type": ["integer", "null"], "minimum": 0},
    "max_capacity_units": {"type": ["number", "null"], "minimum": 0},
    "enabled": {"type": "boolean"},
    "metadata": {"type": "object"}
  }
}
