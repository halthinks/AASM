bool decision_proposed=false; bool obligation_open=false; bool memory_evidence=false; bool history_present=false; bool source_stale=false; bool memory_visible=false; bool tombstoned=false; bool private_memory; bool principal_match; bool projection_selected=false; bool index_touched=false; byte memory_identity=1; byte used_budget=0; byte max_budget=2;
active proctype MemoryModel(){ if :: private_memory=false :: private_memory=true fi; if :: principal_match=false :: principal_match=true fi; do :: !decision_proposed -> decision_proposed=true :: decision_proposed && !obligation_open -> obligation_open=true :: obligation_open && !memory_evidence -> memory_evidence=true; history_present=true; memory_visible=true :: memory_evidence && !source_stale -> source_stale=true; memory_visible=false; projection_selected=false :: memory_evidence && !tombstoned -> tombstoned=true; memory_visible=false; projection_selected=false :: memory_evidence && !index_touched -> index_touched=true :: memory_evidence && !projection_selected -> if :: memory_visible && (!private_memory || principal_match) -> projection_selected=true :: else -> skip fi :: used_budget<max_budget -> used_budget++ od }
never { do :: assert(!memory_visible || (decision_proposed && obligation_open && memory_evidence)); assert(!source_stale || (!memory_visible && !projection_selected)); assert(!tombstoned || (history_present && !memory_visible)); assert(!index_touched || memory_identity==1); assert(!(private_memory && projection_selected) || principal_match); assert(used_budget<=max_budget) od }
